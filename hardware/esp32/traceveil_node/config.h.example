// Copy to config.h and edit for the physical node. Never commit config.h.
#pragma once

// --- Wi-Fi (lab VLAN, isolated from the internet) ---
#define TV_WIFI_SSID        "traceveil-lab"
#define TV_WIFI_PSK         "change-me"

// --- Traceveil case and identity (must match backend registration) ---
#define TV_CASE_ID          1
#define TV_SOURCE_ID        "esp32-lab-01"
#define TV_DEVICE_ID        "esp32-lab-01"
#define TV_SOURCE_TOKEN     "replace-with-a-long-random-token"

// --- Transport selection: exactly one of these must be 1 ---
#define TV_TRANSPORT_HTTP   1
#define TV_TRANSPORT_MQTT   0

// --- HTTP endpoint (Phase 3 live collector) ---
#define TV_HTTP_HOST        "10.10.0.5"
#define TV_HTTP_PORT        8000
#define TV_HTTP_PATH        "/api/v1/live/telemetry"
#define TV_HTTP_TLS         0            // 1 = HTTPS with pinned root cert
// If TV_HTTP_TLS == 1 provide the PEM below; otherwise leave empty.
static const char TV_HTTP_ROOT_CA_PEM[] = "";

// --- MQTT broker (only used when TV_TRANSPORT_MQTT == 1) ---
#define TV_MQTT_HOST        "10.10.0.5"
#define TV_MQTT_PORT        8883
#define TV_MQTT_CLIENT_ID   "esp32-lab-01"
#define TV_MQTT_TLS         1
#define TV_MQTT_FAILOVER_MS 4000         // Fall back to HTTP if broker silent this long.

// --- Sampling and cadence ---
#define TV_SAMPLE_INTERVAL_MS   3000
#define TV_HEARTBEAT_MS         15000

// --- Pins ---
#define TV_PIN_DHT              4
#define TV_PIN_PIR             27
#define TV_PIN_RELAY           26
#define TV_PIN_STATUS_LED       2

// --- Thresholds surfaced to detection rules via metrics ---
#define TV_TEMP_C_ALERT_ABOVE   32.0f
