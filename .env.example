APP_NAME=Traceveil
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///../data/traceveil.db
EVIDENCE_STORAGE_PATH=../data/evidence
REPORT_STORAGE_PATH=../data/reports
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional local AI. Batch investigation remains available when Ollama is absent.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen9b-q4_k_m
OLLAMA_TIMEOUT_SECONDS=2
MAX_EVIDENCE_FILE_BYTES=52428800
MAX_VALIDATION_ISSUES=100

# Optional live telemetry and hardware integration. Empty is correct for batch-only use.
LIVE_SOURCE_TOKENS={}
LIVE_QUEUE_SIZE=2048
LIVE_RATE_LIMIT_PER_SECOND=30
LIVE_MAX_PAYLOAD_BYTES=65536
LIVE_STREAM_RETENTION=10000
LIVE_STREAM_RETENTION_HOURS=24
LIVE_DEVICE_STALE_SECONDS=30

# Optional approval-gated email delivery. A blank host keeps SMTP disabled.
SMTP_HOST=
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=traceveil@localhost
SMTP_ALLOWED_RECIPIENT_DOMAINS=["example.test"]
